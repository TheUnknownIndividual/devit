# All optional. Without an LLM key the offline writer and editor run instead.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3
NEAR_AI_MODEL_LIGHT=z-ai/glm-5.3-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_LIGHT=claude-haiku-5-5
# Last fallback (the key neartrade runs on), for local work until a NEAR AI key is in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

# Solana names, logos and holder counts through Helius DAS.
HELIUS_API_KEY=

# Override the default public RPCs.
NEAR_RPC_URL=
SOLANA_RPC_URL=
ETHEREUM_RPC_URL=
ROBINHOOD_RPC_URL=

# NEAR Intents 1-Click. The JWT lifts rate limits; the fee pair adds an app fee to any-chain buys.
ONECLICK_JWT=
ONECLICK_FEE_BPS=
ONECLICK_FEE_RECIPIENT=

# X: recent posts of the team's account (same provider neartrade uses). One call per account, cached 6 h in data/x.
TWITTERAPI_IO_KEY=
# "Connect your X" sign-in (OAuth 2.0). Without these the landing page asks for the handle instead.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Published sites on subdomains: <slug>.<SITES_DOMAIN>. Leave empty to serve them at /s/<slug>.
SITES_DOMAIN=
# Shared with the Cloudflare Worker in edge/ (wrangler secret put EDGE_SECRET) so it can pass the visitor's host.
EDGE_SECRET=
# Custom domains (Pro): what customers CNAME their domain to. Empty: sites.<SITES_DOMAIN>. See edge/README.md.
CUSTOM_DOMAIN_TARGET=
# Cloudflare for SaaS: with both set, a verified domain gets its custom hostname and certificate automatically.
# Token scope: Zone > SSL and Certificates > Edit, on the sites zone. Without them, add custom hostnames by hand.
CF_API_TOKEN=
CF_ZONE_ID=

# In-site buys. A fee is added only when SWAP_FEE_BPS is set (max 200) and the receiver for that chain is set.
SWAP_FEE_BPS=
# Solana: a Jupiter referral fee token account (WSOL or the output mint) owned by the fee wallet.
JUP_FEE_ACCOUNT=
# Ethereum and Robinhood Chain: the address KyberSwap pays the fee to (charged in ETH).
EVM_FEE_RECEIVER=
# NEAR buys go through the neartrade developer API (dev.neartrade.lol). Works without a key; a key from neartrade /admin lifts the rate limit.
NEARTRADE_API_KEY=

# Accounts. Sessions and anonymous project ownership live in data/accounts; no auth service needed.
# Seals the API keys people bring (AES-256-GCM). 64 hex chars: `openssl rand -hex 32`. Without it, dev makes a local
# key in data/accounts/.secrets-key (and says so in the log); production refuses to store keys.
SECRETS_KEY=
# Email sign-in codes. Without a key, dev prints the code to the server log and production turns email sign-in off.
RESEND_API_KEY=
EMAIL_FROM=
# Google sign-in. Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application); add
# <site>/api/auth/google/callback as an authorized redirect URI. Off when unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Passkeys use the page's own origin. Set these only behind a proxy that rewrites the host.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# Plan payments through NEAR Intents arrive here as USDC on NEAR. Empty: the pay buttons say "Coming soon".
PAYMENTS_NEAR_ACCOUNT=
# Model for people who bring an OpenRouter key (default openrouter/auto).
OPENROUTER_MODEL=
# Accounts that may set any plan by hand on /settings (support, testing): comma-separated account ids or emails.
# The CLI does the same without a sign-in: pnpm grant-plan <email-or-userId> <free|pro|team> [days]
ADMINS=
# Where the "Built with devit" line on free sites links. Empty: https://<SITES_DOMAIN>, else this origin.
APP_URL=
# GitHub sign-in, repo picker and Export to GitHub (OAuth app; callback <site>/api/auth/github/callback). Off when unset.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Sign in with Apple. Off when unset.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Relay (relay.link) cross-chain buys. Works without a key; the key lifts rate limits, the fee pair adds an app fee.
RELAY_API_KEY=
RELAY_FEE_BPS=
RELAY_FEE_RECIPIENT=
# NEAR transfers on the Treasury block (NearBlocks). Works without a key at a lower rate.
NEARBLOCKS_API_KEY=
# Domain search and registration through Spaceship. Purchases stay off unless DOMAIN_PURCHASES=live.
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
SPACESHIP_CONTACT_ID=
DOMAIN_PURCHASES=
DOMAIN_FEE_USD=
# Previous SECRETS_KEY while rotating: sealed values open with either, new ones seal with SECRETS_KEY.
SECRETS_KEY_PREV=
# Model price overrides for the credit meter, JSON {"model": [usd_per_M_in, usd_per_M_out]}.
MODEL_PRICES=
# Google Analytics for the builder site itself.
NEXT_PUBLIC_GA_ID=
